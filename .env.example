# Copy to .env and fill in. NEVER commit .env.

# LLMs
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
PLANNER_MODEL=qwen2.5:3b

# Critic — binary contradiction check, small model is sufficient
CRITIC_MODEL=qwen2.5:3b
CRITIC_LLM_TIMEOUT=20
CRITIC_MAX_VERIFICATIONS=10

# Entity — retype-only cleanup pass, bounded to ambiguous candidates
ENTITY_CLEANUP_ENABLED=true
ENTITY_CLEANUP_MODEL=qwen2.5:7b
ENTITY_CLEANUP_TIMEOUT=150
ENTITY_CLEANUP_MAX_CANDIDATES=20
ENTITY_CLEANUP_CONFIDENCE_THRESHOLD=0.7

# Collection APIs
SEARCH_API_KEY=
NEWS_API_KEY=
GITHUB_TOKEN=

# Database
POSTGRES_USER=osint
POSTGRES_PASSWORD=osint
POSTGRES_DB=defenseosint
DATABASE_URL=postgresql://osint:osint@postgres:5432/defenseosint

# A2A peers (docker service names)
PLANNER_URL=http://planner-agent:8000
COLLECTOR_URL=http://collector-agent:8000
ENTITY_URL=http://entity-agent:8000
CRITIC_URL=http://critic-agent:8000
ANALYST_URL=http://analyst-agent:8000

# Security
A2A_SHARED_TOKEN=change-me
GATEWAY_JWT_SECRET=change-me

# Gateway login — single predefined analyst account, not a user table.
GATEWAY_ANALYST_USERNAME=analyst
GATEWAY_ANALYST_PASSWORD=change-me
GATEWAY_TOKEN_TTL_MINUTES=480
